# Infrastructure-level secrets only. Marketplace API credentials are managed
# through the Admin > Integrations UI and stored encrypted in the database —
# you do NOT need to edit this file when adding/rotating a marketplace token.

# Prisma datasource. For local dev, SQLite is used (zero setup):
DATABASE_URL="file:./dev.db"
# For Postgres in production:
# DATABASE_URL="postgresql://user:password@localhost:5432/marketplace_monitor"

# Used to sign admin session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Used to encrypt marketplace credentials at rest (AES-256-GCM).
# Must be exactly 32 bytes. Generate with: openssl rand -base64 32
ENCRYPTION_KEY="replace-with-a-32-byte-random-key"
